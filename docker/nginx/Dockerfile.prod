# syntax=docker/dockerfile:1.6
FROM nginx:1.27-alpine

COPY docker/nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Targets /admin/login/, not /: this project's urls.py only registers
# admin/, so GET / is a guaranteed 404, which wget treats as a failure.
# Uses 127.0.0.1, not localhost: this image's /etc/hosts resolves
# "localhost" to ::1 first, but nginx.conf only has "listen 80;" (IPv4),
# so wget would get "connection refused" over the IPv6 route.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://127.0.0.1/admin/login/ || exit 1
