:80 {
	encode gzip

	handle_path /static/* {
		root * /app/staticfiles
		file_server
	}

	reverse_proxy api:8000
}

# To get automatic HTTPS once you have a real domain pointed at this server:
#   1. replace `:80` above with your domain, e.g. `example.com`
#   2. add "443:443" to the caddy service's ports in docker-compose.prod.yml
# Caddy then obtains and renews a Let's Encrypt certificate on its own —
# no certbot, no manual renewal cron, unlike the nginx alternative.
