# =====================================================
# Production environment variables
# =====================================================
# Replace these placeholder values with strong random secrets
# before deploying to a real production environment!
# Generate a strong key with:
#   openssl rand -base64 50
# =====================================================

DEBUG=0

# REQUIRED: generate your own before deploying — openssl rand -base64 50
SECRET_KEY=CHANGE-ME-run-openssl-rand--base64-50

# Comma-separated list of allowed hostnames for this Django app.
# Replace "your-domain.com" with your real domain(s) (and subdomains).
# Keep "localhost" and "127.0.0.1" in this list even in real deployments:
# the api container's own HEALTHCHECK hits http://localhost:8000/admin/login/
# from inside the container itself, and the nginx/Caddy healthcheck proxies
# a request with Host: 127.0.0.1 through to it — Django would 400 both as
# DisallowedHost without these. Neither is reachable from outside each
# container's own network namespace, so this isn't a real attack surface.
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,localhost,127.0.0.1

# ---- PostgreSQL ----
POSTGRES_DB=django_db
POSTGRES_USER=django_user
# REQUIRED: generate your own before deploying — openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE-ME-run-openssl-rand--base64-32
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
